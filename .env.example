PORT=3001
GEMINI_API_KEY=your-gemini-api-key-here

# gemini-3.6-flash is the recommended default (see README for why). If you're
# actively developing and want to conserve its daily free-tier quota, a
# lighter model like gemini-3.5-flash-lite works too — it has its own
# separate quota, at some cost to the extractor's judgment calls.
GEMINI_MODEL=gemini-3.6-flash
