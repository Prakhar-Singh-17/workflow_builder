PORT=3001
GEMINI_API_KEY=your-gemini-api-key-here

# Use a lighter model (separate free-tier daily quota) while building/testing,
# so we don't burn the 20-requests/day limit on the model you actually want
# for the final demo. Swap to a stronger model (e.g. gemini-3.6-flash) once
# development is done — see README for the recommendation.
GEMINI_MODEL=gemini-3.5-flash-lite
